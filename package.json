{
  "name": "tu-ruc-js-client",
  "version": "0.2.0",
  "description": "Cliente Javascript para la API de TuRuc Paraguay",
  "keywords": [
    "paraguay",
    "razon",
    "set",
    "turuc"
  ],
  "license": "ISC",
  "author": "Sebastian Alvarez, Esteban Fernandez, Matias Ramirez",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ithdev/tu-ruc-js-client.git"
  },
  "files": [
    "src/",
    "CHANGELOG.md"
  ],
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "lint": "oxlint --deny-warnings . && eslint . --max-warnings 0",
    "test": "jest",
    "test:package": "node scripts/check-package.cjs",
    "lint:fix": "oxlint --deny-warnings --fix . && eslint . --fix --max-warnings 0",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check ."
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "5.10.0",
    "eslint": "10.12.0",
    "eslint-plugin-jsdoc": "65.3.1",
    "jest": "30.5.2",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0"
  },
  "engines": {
    "node": ">=22"
  }
}
